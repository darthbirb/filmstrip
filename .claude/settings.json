{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npx --yes pnpm@12.4.1 *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "PowerShell(npx --yes pnpm@12.4.1 *)",
      "PowerShell(cargo check *)",
      "PowerShell(git status *)",
      "PowerShell(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(git push -u origin *)",
      "PowerShell(git push origin *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * *:main)",
      "Bash(git push --all *)",
      "Bash(git push --mirror *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main:*)",
      "PowerShell(git push * *:main)",
      "PowerShell(git push --all *)",
      "PowerShell(git push --mirror *)",
      "PowerShell(gh pr merge *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(npx shadcn add *)",
      "Bash(npm install *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.claude/settings.local.json)"
    ]
  }
}
